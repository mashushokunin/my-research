# =========================
# Python 仮想環境
# =========================
.venv/
venv/
env/

# =========================
# Python キャッシュ
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# =========================
# MATLAB / Simulink
# ソースの .m, .mlx, .slx はGit管理する
# =========================
*.asv
*.m~
autosave/
slprj/
*.slxc
codegen/
*.mex*

# =========================
# Jupyter Notebook 関連
# =========================
.ipynb_checkpoints/

# =========================
# macOS / VS Code
# =========================
.DS_Store
.vscode/

# =========================
# 環境変数・秘密情報
# =========================
.env
.env.*
*.key
*.pem

# =========================
# データセット
# 大きい画像・動画・生データはGitHubに上げない
# =========================
data/raw/
data/processed/
data/interim/
data/euroc/

# ただし、サンプルデータだけはGit管理してOK
!data/sample/
!data/sample/**

# =========================
# 実験結果
# 大きな出力はGit管理しないが、小さい要約CSVは再現性のため管理できる
# =========================
results/*
!results/README.md
!results/**/
results/**/*
!results/**/
!results/**/README.md
!results/**/summary.csv
!results/**/group_summary.csv
!results/**/sequence_summary.csv
!results/**/ate_summary.csv
outputs/
logs/

# =========================
# 外部成果物
# 大きなモデル、データ、ビルド成果物は artifacts/README.md に取得方法を残す
# =========================
artifacts/*
!artifacts/README.md

# =========================
# 画像・動画・重いファイル
# 必要なら data/sample/ に小さいサンプルだけ置く
# =========================
*.avi
*.mkv
*.bag
*.zip
*.tar
*.tar.gz
*.7z
*.mov
*.MOV
*.mp4
*.MP4

# =========================
# 一時ファイル
# =========================
*.tmp
*.log
